---
import { Image } from "astro:assets";
import Logo from "@public/logo.png";
import {
  CONTACT_EMAIL,
  SCHEDULE_URL_BUSINESS,
  IS_EXTERNAL_SCHEDULE_URL,
} from "../lib/scheduling";

interface Props {
  /** 上段の相談の案内を省く（フォームの直後に置くページなど） */
  hideCta?: boolean;
  /** 「相談する」の行き先 */
  contactHref?: string;
}

const { hideCta = false, contactHref = "/techplantstudio/#contact" } = Astro.props;

const scheduleAttrs = IS_EXTERNAL_SCHEDULE_URL
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

const nologicUrl =
  "https://nologic.app/?utm_source=creatorpot&utm_medium=referral&utm_campaign=corporate_site&utm_content=footer_text";

const groups = [
  {
    title: "ご依頼",
    links: [
      { href: "/techplantstudio/", label: "ゲーム制作のご相談" },
      { href: "/techplantstudio/ip-minigame/", label: "IPのミニゲーム制作" },
      { href: "/business-game/", label: "社内研修のゲーム制作" },
      { href: "/techplantstudio/#ai-training", label: "AI研修・導入支援" },
    ],
  },
  {
    title: "自社で運営しているもの",
    links: [
      { href: nologicUrl, label: "NoLogic（ゲーム制作基盤）", external: true },
      { href: "https://discord.gg/3hy2UNmXca", label: "NextCreators（Discord）", external: true },
      { href: "/essay/", label: "代表のエッセイ" },
    ],
  },
  {
    title: "会社",
    links: [
      { href: "/#company", label: "会社情報" },
      { href: "/news/", label: "お知らせ" },
      { href: "/privacy/", label: "プライバシーポリシー" },
      { href: "https://twitter.com/creator_pot", label: "X（@creator_pot）", external: true },
      { href: "https://note.com/creator_pot", label: "note", external: true },
    ],
  },
];
---

<footer class="site-footer">
  {
    !hideCta && (
      <section class="band rule-ink" aria-labelledby="footer-cta-title">
        <div class="shell grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker">ご相談</p>
            <h2 id="footer-cta-title" class="h2 mt-2">作りたいものが決まっていなくても、ご相談いただけます。</h2>
            <p class="body mt-4 measure">
              目的と、公開したい時期と、ご予算の目安が分かれば、進め方と費用の見通しをお返しします。お返事は2営業日以内です。
            </p>
          </div>
          <div class="flex flex-col gap-4 lg:col-span-5 lg:items-end">
            <div class="flex flex-wrap gap-3">
              <a href={contactHref} class="btn" data-cta-location="footer">相談する</a>
              <a href={SCHEDULE_URL_BUSINESS} {...scheduleAttrs} class="btn-line" data-schedule-location="footer">
                打ち合わせの日程を選ぶ
              </a>
            </div>
            <p class="small">
              メール: <a class="link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <div class="footer-bottom">
    <div class="shell py-14">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <a href="/" class="inline-flex items-center gap-3" aria-label="トップページへ">
            <Image src={Logo} alt="" width={62} height={56} class="h-8 w-auto" />
            <span class="text-[15px] font-bold">株式会社クリエイターのうえきばち</span>
          </a>
          <p class="small mt-4">
            東京都千代田区神田神保町3丁目21-7<br />英弘ビル3F みらいスタジオ
          </p>
        </div>
        <div class="grid gap-10 sm:grid-cols-3 md:col-span-8">
          {groups.map((g) => (
            <div>
              <p class="text-[13px] font-bold text-[var(--muted)]">{g.title}</p>
              <ul class="mt-3 flex flex-col gap-2">
                {g.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="footer-link"
                      {...("external" in l && l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
      <p class="mt-12 border-t border-[var(--rule)] pt-6 text-[12px] text-[var(--muted)]">
        &copy; {new Date().getFullYear()} 株式会社クリエイターのうえきばち
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
  }

  .footer-bottom {
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
  }

  .footer-link {
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
