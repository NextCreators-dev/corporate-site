---
import { SEO } from "astro-seo";
import { organizationSchema, websiteSchema } from "../lib/seo";

interface Props {
    title?: string;
    description?: string;
    /** OGPタイプ（記事ページは "article"） */
    type?: "website" | "article";
    /** OGP画像URL（未指定時は共通の OGP.png） */
    image?: string;
    /** インデックスを拒否する場合 true */
    noindex?: boolean;
    /** ページ固有の構造化データ（JSON-LD）配列 */
    jsonLd?: object[];
    /** ヒーロー H1 用の明朝（Shippori Mincho）を読み込むか。
     *  preload は高優先度で他の取得と帯域を奪い合うので、
     *  この書体を使わないページは false を渡して preload と @font-face ごと落とす。既定 true */
    preloadMincho?: boolean;
}

// ページ固有のタイトル・ディスクリプションを受け取り、未指定時はサイト共通の既定値にフォールバックする
const defaultTitle = "株式会社クリエイターのうえきばち";
const defaultDescription =
    "株式会社クリエイターのうえきばちは、ノーコードでゲーム制作ができるプラットフォームの開発や、クリエイターコミュニティ運営を手掛けています。";
const {
    title = defaultTitle,
    description = defaultDescription,
    type = "website",
    image,
    noindex = false,
    jsonLd = [],
    preloadMincho = true,
} = Astro.props;

// 各ページの canonical URL（クエリ・ハッシュは除外）
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ?? import.meta.env.SITE + "/OGP.png";

// Google Search Console 認証コード（Netlify等の環境変数で設定）
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
// GA4 測定ID（例: G-XXXXXXXXXX）。環境変数で設定されていない場合はタグを出力しない
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

// 全ページ共通の構造化データ（Organization / WebSite）+ ページ固有の構造化データ
const schemas = [organizationSchema(), websiteSchema(), ...jsonLd];

// Shippori Mincho の @font-face。<style> の中身は CSS の生テキストとして扱われるため、
// テンプレート式を直接書かず、この文字列を set:html で流し込む。
const minchoFaceCss = `
    @font-face {
        font-family: "Shippori Mincho";
        font-style: normal;
        font-weight: 800;
        font-display: optional;
        src: url("/fonts/shippori-mincho-800-subset.woff2") format("woff2");
    }
`;
---

<SEO
    title={title}
    description={description}
    charset="utf-8"
    canonical={canonicalUrl}
    noindex={noindex}
    nofollow={noindex}
    openGraph={{
        basic: {
            title: title,
            type: type,
            image: ogImage,
            url: canonicalUrl,
        },
        optional: {
            description: description,
            siteName: defaultTitle,
            locale: "ja_JP",
        },
    }}
    twitter={{
        card: "summary_large_image",
        site: "@creator_pot",
        creator: "@creator_pot",
    }}
    extend={{
        link: [
            {
                rel: "icon",
                href: "/favicon.ico",
            },
        ],
        meta: [
            ...(gscVerification
                ? [{ name: "google-site-verification", content: gscVerification }]
                : []),
        ],
    }}
/>

<!-- 構造化データ（JSON-LD） -->
{
    schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))
}

<!-- Shippori Mincho 800（ヒーロー H1 専用 / 必要文字のみサブセット）を自己ホスト -->
<!-- レンダーブロックを避けるため preload + インライン @font-face で読み込み、font-display: optional で CLS=0 を担保 -->
{
    preloadMincho && (
        <Fragment>
            <link
                rel="preload"
                href="/fonts/shippori-mincho-800-subset.woff2"
                as="font"
                type="font/woff2"
                crossorigin
            />
            <style is:inline set:html={minchoFaceCss} />
        </Fragment>
    )
}

{
    gaMeasurementId && (
        <script is:inline define:vars={{ gaMeasurementId }}>
            // GTM/GA4 を load 後に遅延注入してパフォーマンスへの影響を回避する
            // ページビューは config 呼び出し時点で送信されるため、遅延しても計測は正しく行われる
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("js", new Date());
            gtag("config", gaMeasurementId);

            function loadGtag() {
                var s = document.createElement("script");
                s.async = true;
                s.src =
                    "https://www.googletagmanager.com/gtag/js?id=" +
                    gaMeasurementId;
                document.head.appendChild(s);
            }

            // load 後にアイドル時間で読み込み。直帰計測ロスを抑えるため timeout を設定
            function schedule() {
                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadGtag, { timeout: 1500 });
                } else {
                    setTimeout(loadGtag, 200);
                }
            }
            if (document.readyState === "complete") {
                schedule();
            } else {
                window.addEventListener("load", schedule, { once: true });
            }
        </script>
    )
}
