---
import { Image } from "astro:assets";
import Logo from "@public/logo.png";

interface Props {
  /** 右上の「相談する」の行き先。フォームを持つページは自分の #contact を渡す */
  contactHref?: string;
  /** いま開いているページ。該当するリンクに aria-current を付ける */
  current?: "home" | "studio" | "ip" | "ai" | "news";
}

const { contactHref = "/techplantstudio/#contact", current } = Astro.props;

// 読み手が「自分の用件はどこか」で選べるよう、受託の入口を先に並べる
const links = [
  { href: "/techplantstudio/", label: "ゲーム制作のご相談", key: "studio" },
  { href: "/techplantstudio/ip-minigame/", label: "IPのミニゲーム", key: "ip" },
  { href: "/techplantstudio/#ai-training", label: "AI研修", key: "ai" },
  { href: "/#company", label: "会社情報", key: "home" },
  { href: "/news/", label: "お知らせ", key: "news" },
] as const;
---

<header class="site-header fixed inset-x-0 top-0 z-50">
  <div class="shell flex h-[68px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="株式会社クリエイターのうえきばち トップページ">
      <Image src={Logo} alt="" width={120} height={109} loading="eager" class="h-9 w-auto" />
      <span class="hidden text-[15px] font-bold tracking-[0.02em] text-[var(--ink)] sm:inline">クリエイターのうえきばち</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="サイト内の案内">
      {links.map((l) => (
        <a
          href={l.href}
          class="nav-link text-[14px] font-bold"
          aria-current={current === l.key && l.key !== "home" ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={contactHref} class="btn btn--sm hidden md:inline-flex" data-cta-location="nav">相談する</a>
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        メニュー
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true" aria-label="メニュー">
  <div class="shell flex h-[68px] items-center justify-end">
    <button id="close-menu" type="button" class="menu-btn">閉じる</button>
  </div>
  <nav class="shell mt-4 flex flex-col" aria-label="サイト内の案内">
    {links.map((l) => (
      <a href={l.href} class="mobile-link">{l.label}</a>
    ))}
    <a href={contactHref} class="btn mt-8" data-cta-location="nav_mobile">相談する</a>
  </nav>
</div>

<!-- 固定ヘッダーの高さ分、本文を下げる -->
<div class="h-[68px]" aria-hidden="true"></div>

<style>
  .site-header {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-link {
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--accent-ink);
  }

  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .menu-btn {
    min-height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .mobile-menu {
    background: var(--paper);
  }

  .mobile-menu.is-open {
    display: block;
  }

  .mobile-link {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("close-menu");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>
