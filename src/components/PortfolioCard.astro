---
// 実績1件を1行で見せる。読み手が「自分の依頼に近い実績があるか」を
// 上から順に読み比べられるよう、カードを横に並べずに行の一覧にする（決定 0087）
import type { PortfolioItem } from "../data/portfolio";

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;

// 区分と状態は1行の文字で示す（色つきのバッジにしない）
const meta = [item.categoryLabel, item.statusLabel].filter(Boolean).join("・");
---

<article class="grid gap-6 border-b border-[var(--rule)] py-8 md:grid-cols-12 md:gap-10">
  {
    item.image && (
      <figure class="md:col-span-5">
        <img
          src={item.image}
          alt={`${item.title}の画面`}
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          class="block aspect-video w-full rounded-lg border border-[var(--rule)] bg-[var(--card)] object-cover"
        />
      </figure>
    )
  }

  <div class:list={["flex flex-col gap-3", item.image ? "md:col-span-7" : "md:col-span-12"]}>
    <p class="small font-bold">{meta}</p>
    <h3 class="h3">{item.title}</h3>
    <p class="body">{item.description}</p>

    {
      item.metrics && item.metrics.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-1">
          {item.metrics.map((metric) => (
            <li class="body num font-bold text-[var(--ink)]">{metric}</li>
          ))}
        </ul>
      )
    }

    <p class="small">使ったもの: {item.techStack.join("、")}</p>

    {
      item.url && (
        <p class="small">
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="link">
            サイトを開く（別のタブ）
          </a>
        </p>
      )
    }
  </div>
</article>
