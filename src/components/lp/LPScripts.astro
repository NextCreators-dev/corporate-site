---
// LP共通スクリプト（要件定義 §5-1 / §5-8 / §6）
// - スクロールインアニメーション（prefers-reduced-motion 尊重 / opacity+transform のみで CLS=0）
// - GA4 計測: cta_click / section_impression / schedule_click / faq_expand
//   lp_id は <main data-lp-id="..."> から読み取り、schedule_click に付与する（§3-7）。
//
// このコンポーネントを各LPの <main> 内に1つ置くだけで上記が有効化される。
---

<style>
  /* 初期状態（非表示）。.animate-on-scroll は JS が付与するため、JS無効時は通常表示される */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 400ms ease-out,
      transform 400ms ease-out;
  }

  .animate-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0) translateX(0);
  }

  /* スタガー用ディレイ */
  .animate-on-scroll[data-delay="1"] { transition-delay: 100ms; }
  .animate-on-scroll[data-delay="2"] { transition-delay: 200ms; }
  .animate-on-scroll[data-delay="3"] { transition-delay: 300ms; }
  .animate-on-scroll[data-delay="4"] { transition-delay: 400ms; }
  .animate-on-scroll[data-delay="5"] { transition-delay: 500ms; }

  /* prefers-reduced-motion 対応 */
  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // ===========================
  // スクロールアニメーション
  // ===========================
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    document.querySelectorAll("section[data-section]").forEach((section) => {
      // セクションタイトル（h2）
      const h2 = section.querySelector("h2");
      if (h2) h2.classList.add("animate-on-scroll");

      // h2 直後の説明文（リード）
      const desc = h2?.nextElementSibling;
      if (desc && desc.tagName === "P") {
        desc.classList.add("animate-on-scroll");
        (desc as HTMLElement).dataset.delay = "1";
      }

      // グリッド内のカードにスタガーアニメーション
      section.querySelectorAll(".grid > div, .grid > a").forEach((card, i) => {
        card.classList.add("animate-on-scroll");
        (card as HTMLElement).dataset.delay = String(Math.min(i + 1, 5));
      });

      // CTAボタン
      section.querySelectorAll("a[data-cta-location]").forEach((cta) => {
        cta.classList.add("animate-on-scroll");
      });
    });

    const animObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            animObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll(".animate-on-scroll").forEach((el) => {
      animObserver.observe(el);
    });
  }

  // ===========================
  // GA4 イベントトラッキング
  // ===========================

  // gtagラッパー（GA4タグ未設置でもエラーにならないようガード）
  function trackEvent(eventName: string, params: Record<string, string> = {}) {
    if (
      typeof window !== "undefined" &&
      typeof (window as any).gtag === "function"
    ) {
      (window as any).gtag("event", eventName, params);
    }
  }

  // lp_id（schedule_click に付与する商談化の分母識別子 §3-7）
  const lpId =
    document.querySelector("main[data-lp-id]")?.getAttribute("data-lp-id") || "";

  // CTAクリック（汎用）
  document.querySelectorAll("[data-cta-location]").forEach((el) => {
    el.addEventListener("click", () => {
      const location = (el as HTMLElement).dataset.ctaLocation || "";
      trackEvent("cta_click", { cta_location: location, lp_id: lpId });
    });
  });

  // 日程調整リンククリック（商談化の主要分子 §3-7）
  document.querySelectorAll("[data-schedule-cta]").forEach((el) => {
    el.addEventListener("click", () => {
      const location = (el as HTMLElement).dataset.ctaLocation || "";
      trackEvent("schedule_click", { cta_location: location, lp_id: lpId });
    });
  });

  // セクションimpression（IntersectionObserver）
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const sectionName = (entry.target as HTMLElement).dataset.section;
          if (sectionName) {
            trackEvent("section_impression", {
              section_name: sectionName,
              lp_id: lpId,
            });
          }
          sectionObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  document.querySelectorAll("section[data-section]").forEach((el) => {
    sectionObserver.observe(el);
  });

  // FAQアコーディオン開閉トラッキング
  document.querySelectorAll("details").forEach((detail) => {
    detail.addEventListener("toggle", () => {
      if ((detail as HTMLDetailsElement).open) {
        const summary = detail.querySelector("summary");
        const questionText = summary?.textContent?.trim() || "";
        trackEvent("faq_expand", { faq_question: questionText, lp_id: lpId });
      }
    });
  });
</script>
