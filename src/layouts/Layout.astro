---
import Head from "@components/Head.astro";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** ヒーロー H1 用の明朝を読み込むか。使わないページは false（既定 true） */
  preloadMincho?: boolean;
}

// 受け取ったSEO情報をそのまま Head へ受け渡す
// <head> の name="head" スロットはページ固有の追記口（書体の読み込みなど）。
// 差し込むページが無ければ何も出力しない。
const props = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Head {...props} />
    <!-- 本文の書体。/business-game/ と同じ Zen Kaku Gothic New をサイト全体で使う -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700;900&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      // CTA と日程調整のクリックを GA4 に送る（全ページ共通）。
      // data-cta-location → cta_click、data-schedule-location → schedule_click。
      // どのページのどの位置から押したかで、改修が商談に効いたかを判定する（決定 0087）
      import { trackEvent } from "../lib/gtag";

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const el = target?.closest<HTMLElement>("[data-cta-location], [data-schedule-location]");
        if (!el) return;
        const page_path = window.location.pathname;
        if (el.dataset.scheduleLocation) {
          trackEvent("schedule_click", { cta_location: el.dataset.scheduleLocation, lp_id: page_path, page_path });
        } else if (el.dataset.ctaLocation) {
          trackEvent("cta_click", { cta_location: el.dataset.ctaLocation, page_path });
        }
      });
    </script>
  </body>
</html>
