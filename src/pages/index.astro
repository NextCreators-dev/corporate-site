---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import CEOPhoto from "@public/ceo-photo.png";
import nekoArt from "@public/portfolio/nologic-nekogame.png";
import { newsItems } from "../data/news";
import { members } from "../data/members";
import { portfolioItems } from "../data/portfolio";

// トップに来るのは、代表からの連絡や紹介で社名を知り、確かめに来た企業の担当者が多い。
// 最初の画面で「何を頼める会社か」を言い切り、次に用件ごとの入口と料金の目安を並べる。
// NoLogic とコミュニティは、受託を支える自社の取り組みとして後ろに置く。

const nologicUrl =
  "https://nologic.app/?utm_source=creatorpot&utm_medium=referral&utm_campaign=corporate_site&utm_content=top_nologic";

// 用件ごとの入口。読み手が自分の用件を見つけ、料金の目安と行き先を一度に読めるようにする
const routes = [
  {
    title: "作品の告知やイベントに使うミニゲーム",
    who: "アニメ・漫画・キャラクターなどの版権をお持ちの企業、VTuber 事務所の方へ",
    body: "作品のキャラクターで遊べるブラウザゲームを作ります。URL と QR コードで配れて、監修の工程を最初の予定に組み込みます。",
    price: "内容を伺ってお見積り",
    term: "早ければ2週間",
    href: "/techplantstudio/ip-minigame/",
    cta: "top_route_ip",
  },
  {
    title: "Unity でのゲーム開発",
    who: "ゲームを作りたい企業、開発の手が足りないゲーム会社の方へ",
    body: "企画や仕様の整理から、実装、QA まで受けます。動く試作から始めて、触りながら仕様を固めることもできます。",
    price: "50万円〜",
    term: "1〜4か月",
    href: "/techplantstudio/#unity",
    cta: "top_route_unity",
  },
  {
    title: "広告・キャンペーン・イベント用のブラウザゲーム",
    who: "広告代理店、Web 制作会社、イベント制作会社の方へ",
    body: "クライアント案件のゲームの部分をお受けします。ゲーム単体のほか、広告ページや企画と組み合わせた制作もできます。",
    price: "20万円〜（広告ページや企画とあわせて50万〜100万円）",
    term: "早ければ2週間",
    href: "/techplantstudio/#minigame",
    cta: "top_route_minigame",
  },
  {
    title: "社内研修・理念浸透のゲーム",
    who: "新入社員研修や社内の交流にゲームを使いたい企業の方へ",
    body: "会社の歴史や行動指針を、クイズやノベル形式のゲームにします。",
    price: "50万円〜",
    term: "試作まで最短1週間",
    href: "/business-game/",
    cta: "top_route_business",
  },
  {
    title: "AI 研修・導入支援",
    who: "保育・療育の事業所など、現場で AI を使い始めたい方へ",
    body: "現場の業務に合わせた生成 AI の使い方の研修と、使い続けるための導入支援を行います。",
    price: "研修は内容を伺ってお見積り、導入支援は月5万円〜",
    term: "",
    href: "/techplantstudio/#ai-training",
    cta: "top_route_ai",
  },
];

// 体制は名前と担当だけを短く。詳しい紹介は受託のページに置く
const roster = members.map((m) => ({
  name: m.name,
  role: m.role,
  avatar: m.avatar,
}));

const latestNews = newsItems.slice(0, 3);
---

<Layout
  title="株式会社クリエイターのうえきばち | ゲームの受託開発とゲーム制作基盤 NoLogic"
  description="株式会社クリエイターのうえきばちは、Unity でのゲーム開発と、自社のゲーム制作基盤 NoLogic を使ったブラウザゲームの制作を受けています。作品の告知に使うミニゲーム、研修のゲーム、保育・療育向けの AI 研修もご相談いただけます。"
  preloadMincho={false}
>
  <Navigation current="home" />

  <main>
    <!-- 1. 何を頼める会社か -->
    <section class="band-lg" data-section="hero">
      <div class="shell grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="kicker">株式会社クリエイターのうえきばち</p>
          <h1 class="h1 mt-4"><span class="inline-block">ゲームの制作を、</span><span class="inline-block">絵と音まで</span><span class="inline-block">社内でお受けします。</span></h1>
          <p class="lead mt-6 measure">
            Unity でのゲーム開発と、自社で運営するゲーム制作基盤 NoLogic を使ったブラウザゲームを作っています。作品の告知に使うミニゲームから、試作から始める開発まで、まずはご用件をお聞かせください。保育・療育の現場向けの AI 研修も行っています。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/techplantstudio/#contact" class="btn" data-cta-location="top_hero">相談する</a>
            <a href="#services" class="link font-bold" data-cta-location="top_hero_price">ご用件と料金の目安を見る</a>
          </div>
        </div>
        <figure class="lg:col-span-5">
          <Image
            src={nekoArt}
            alt="ヘルメットやかばんを身につけた5匹の猫のキャラクター"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 480px, 100vw"
            loading="eager"
            class="hero-art w-full"
          />
          <figcaption class="small mt-3">
            NoLogic のゲームのために、所属のクリエイターが描いたキャラクター。絵も社内で描きます。
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. ご用件ごとの入口と料金の目安 -->
    <section id="services" class="band band--alt" data-section="routes">
      <div class="shell">
        <p class="kicker">ご依頼</p>
        <h2 class="h2 mt-2">ご用件から選んでください</h2>
        <p class="body mt-4 measure">
          料金は税別の目安です。正式な金額は、お話を伺ってからお出しします。
        </p>

        <ul class="routes mt-10">
          {routes.map((r) => (
            <li class="route">
              <a href={r.href} class="route-link" data-cta-location={r.cta}>
                <div class="route-main">
                  <h3 class="h3">{r.title}</h3>
                  <p class="small mt-1">{r.who}</p>
                  <p class="body mt-3">{r.body}</p>
                </div>
                <dl class="route-meta">
                  <div>
                    <dt>料金の目安</dt>
                    <dd class="num">{r.price}</dd>
                  </div>
                  {r.term && (
                    <div>
                      <dt>期間の目安</dt>
                      <dd>{r.term}</dd>
                    </div>
                  )}
                </dl>
                <span class="route-go" aria-hidden="true">詳しく見る</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. 自社の制作基盤。短い期間で作れる理由の裏づけ -->
    <section id="nologic" class="band" data-section="nologic">
      <div class="shell grid gap-12 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-5">
          <p class="kicker">制作の土台</p>
          <h2 class="h2 mt-2">自社のゲーム制作基盤 NoLogic の上で作ります</h2>
          <p class="body mt-5">
            NoLogic は、画像を入れてテンプレートを選ぶと、ブラウザで遊べるゲームになる制作基盤です。当社が開発し、運営しています。このプラットフォーム上で作られたゲームは、<strong class="num">600本以上</strong>になりました<span class="nb">（2026年9月時点）</span>。
          </p>
          <p class="body mt-4">
            受託のミニゲームもこの基盤で作るので、ゼロから組むより短い期間で公開まで進められます。遊ぶ人はアプリを入れずに、URL か QR コードを開くだけです。
          </p>
          <p class="small mt-6">
            クリエイターの方は、NoLogic を無料プランから使えます。<a href={nologicUrl} class="link" data-cta-location="top_nologic">NoLogic を開く</a>
          </p>
        </div>
        <figure class="lg:col-span-7">
          <video
            class="block w-full rounded-lg border border-[var(--rule)] bg-[var(--paper-2)]"
            src="/nologic-play.mp4"
            muted
            loop
            playsinline
            preload="metadata"
            width="1280"
            height="720"
            poster="/nologic-play-poster.jpg"
            data-autoplay
            aria-label="NoLogic の制作画面で、キャラクターの画像を入れて落ちものパズルを作っている様子"
          ></video>
          <figcaption class="small mt-3">
            NoLogic の制作画面。キャラクターの画像を入れて、落ちものパズルを作っているところ。
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. 体制。絵・音・開発が社内にそろうことの裏づけ -->
    <section id="team" class="band band--alt" data-section="team">
      <div class="shell">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker">作る人</p>
            <h2 class="h2 mt-2">企画、イラスト、音楽、開発の担当が社内にいます</h2>
          </div>
          <p class="body lg:col-span-5">
            ご相談の窓口は代表の山縣です。各担当の経歴は<a href="/techplantstudio/#team" class="link">受託のページ</a>に載せています。
          </p>
        </div>
        <ul class="roster mt-10">
          {roster.map((m) => (
            <li class="flex items-center gap-4">
              <img src={m.avatar} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-full object-cover" />
              <div>
                <p class="font-bold">{m.name}</p>
                <p class="small">{m.role}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. 実績 -->
    <section id="works" class="band" data-section="works">
      <div class="shell">
        <p class="kicker">実績</p>
        <h2 class="h2 mt-2">これまでの仕事</h2>
        <ul class="mt-10 flex flex-col">
          {portfolioItems.map((item) => (
            <li class="work">
              {item.image && (
                <img src={item.image} alt="" width="320" height="180" loading="lazy" class="work-img" />
              )}
              <div>
                <p class="small">{item.categoryLabel}{item.statusLabel ? `・${item.statusLabel}` : ""}</p>
                <h3 class="h3 mt-1">
                  {item.url ? (
                    <a href={item.url} class="link" target="_blank" rel="noopener noreferrer">{item.title}</a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p class="body mt-2">{item.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. 私たちについて。代表の考えと、自社で運営しているもの -->
    <section id="vision" class="band band--alt" data-section="vision">
      <div class="shell grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">私たちについて</p>
          <h2 class="h2 mt-2">誰もが制作に挑戦できる世界の実現</h2>
          <p class="small mt-4">ミッション: 創作における環境的ハードルを破壊する</p>
        </div>
        <div class="lg:col-span-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
            <Image
              src={CEOPhoto}
              alt="代表取締役 山縣 帆高"
              width={160}
              height={160}
              class="h-32 w-32 shrink-0 rounded-full object-cover"
            />
            <div>
              <p class="lead">
                きっかけは、同級生の退学でした。ゲームを作り続けていた友人が、ある日突然、家庭環境のせいで創作ができなくなり、退学しました。その原体験から、私はこの会社を創業しました。
              </p>
              <p class="small mt-4">
                代表取締役 山縣 帆高。2021年度、未踏IT人材発掘・育成事業に採択。
              </p>
              <p class="mt-4"><a href="/essay/" class="link font-bold">代表のエッセイを読む</a></p>
            </div>
          </div>

          <div class="rule-top mt-12 pt-8">
            <h3 class="h3">自社で運営しているもの</h3>
            <dl class="own mt-4">
              <div>
                <dt class="font-bold">NoLogic</dt>
                <dd class="body">プログラミングなしでゲームを作れる制作基盤。受託のミニゲームもこの上で作ります。<a href={nologicUrl} class="link" data-cta-location="top_own_nologic">nologic.app</a></dd>
              </div>
              <div>
                <dt class="font-bold">NextCreators</dt>
                <dd class="body">ゲーム・イラスト・音楽などの作り手が集まる Discord のコミュニティ。参加は無料です。<a href="https://discord.gg/3hy2UNmXca" class="link" target="_blank" rel="noopener noreferrer" data-cta-location="top_own_discord">参加する</a></dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. お知らせ -->
    <section id="news" class="band" data-section="news">
      <div class="shell grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">お知らせ</p>
          <h2 class="h2 mt-2">最近のお知らせ</h2>
          <p class="mt-4"><a href="/news/" class="link font-bold">一覧を見る</a></p>
        </div>
        <ul class="lg:col-span-8">
          {latestNews.map((n) => (
            <li class="news-row">
              <time class="small num shrink-0" datetime={n.date.replace(/\./g, "-")}>{n.date}</time>
              <a href={`/news/${n.slug}/`} class="news-title">{n.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. 会社概要 -->
    <section id="company" class="band band--alt" data-section="company">
      <div class="shell grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">会社情報</p>
          <h2 class="h2 mt-2">会社概要</h2>
        </div>
        <div class="lg:col-span-8">
          <table class="table-plain">
            <tbody>
              <tr><th scope="row">会社名</th><td>株式会社クリエイターのうえきばち</td></tr>
              <tr><th scope="row">設立</th><td>2024年11月</td></tr>
              <tr><th scope="row">代表取締役</th><td>山縣 帆高</td></tr>
              <tr><th scope="row">所在地</th><td>東京都千代田区神田神保町3丁目21-7 英弘ビル3F みらいスタジオ</td></tr>
              <tr>
                <th scope="row">事業内容</th>
                <td>
                  ゲームの受託開発（Unity・ブラウザゲーム）<br />
                  ゲーム制作基盤「NoLogic」の開発・運営<br />
                  AI 研修・導入支援<br />
                  クリエイターコミュニティ「NextCreators」の運営
                </td>
              </tr>
              <tr><th scope="row">お問い合わせ</th><td><a href="/techplantstudio/#contact" class="link">お問い合わせフォーム</a></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero-art {
    aspect-ratio: 16 / 9;
    object-fit: contain;
    object-position: center;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 12px;
  }

  /* 用件の一覧。カードを並べず、行として読み比べられるようにする */
  .routes {
    border-top: 2px solid var(--ink);
  }

  .route {
    border-bottom: 1px solid var(--rule);
  }

  .route-link {
    display: grid;
    gap: 16px;
    padding: 28px 0;
    color: inherit;
  }

  @media (min-width: 900px) {
    .route-link {
      grid-template-columns: minmax(0, 1fr) 300px 120px;
      gap: 40px;
      align-items: start;
    }
  }

  .route-link:hover .h3,
  .route-link:focus-visible .h3 {
    color: var(--accent-ink);
  }

  .route-link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .route-meta {
    display: grid;
    gap: 10px;
  }

  .route-meta dt {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--muted);
  }

  .route-meta dd {
    font-weight: 700;
    color: var(--ink);
    line-height: 1.6;
  }

  /* 料金は読み手が最初に比べる値なので、一段大きく */
  .route-meta div:first-child dd {
    font-size: 17px;
  }

  .route-go {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 900px) {
    .route-go {
      justify-self: end;
      padding-top: 4px;
    }
  }

  .roster {
    display: grid;
    gap: 20px 32px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .work {
    display: grid;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }

  .work:first-child {
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 768px) {
    .work {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 32px;
    }
  }

  .work-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--rule);
  }

  .own {
    display: grid;
    gap: 20px;
  }

  .own dd {
    margin-top: 4px;
  }

  .own dd .link {
    margin-left: 0.5em;
  }

  .news-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .news-row:first-child {
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 640px) {
    .news-row {
      flex-direction: row;
      gap: 28px;
    }
  }

  .news-title {
    font-weight: 700;
    color: var(--ink);
  }

  .news-title:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>

<script>
  // 動画は画面に入ったときだけ再生する。動きを減らす設定の環境では再生しない
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => {
    if (reduce) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    });
    io.observe(v);
  });
</script>
