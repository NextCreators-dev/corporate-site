<script>
  // 冒頭の理念の文字アニメーション。
  // [data-anim-stagger] の配下の .anim-char を、ランダムな漢字に6回切り替えてから本来の文字に着地させる
  const TICKS = 6;
  const STEP_MS = 50;

  const randomKanji = () => {
    const code = 0x4e00 + Math.floor(Math.random() * (0x9fff - 0x4e00));
    return String.fromCodePoint(code);
  };

  // 各 tick の書き込みを1フレームにまとめ、レイアウトの再計算を減らす
  type Pending = { el: HTMLElement; text: string };
  let pendingWrites: Pending[] = [];
  let rafScheduled = false;
  const scheduleWrite = (el: HTMLElement, text: string) => {
    pendingWrites.push({ el, text });
    if (rafScheduled) return;
    rafScheduled = true;
    requestAnimationFrame(() => {
      const batch = pendingWrites;
      pendingWrites = [];
      rafScheduled = false;
      for (const { el, text } of batch) el.textContent = text;
    });
  };

  const animateTextGroups = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLElement>("[data-anim-stagger]").forEach((group) => {
      const stagger = Number(group.dataset.animStagger) || 25;
      group.querySelectorAll<HTMLElement>(".anim-char").forEach((el, i) => {
        const target = el.dataset.char ?? el.textContent ?? "";
        const startDelay = i * stagger;
        for (let t = 0; t < TICKS; t++) {
          window.setTimeout(() => scheduleWrite(el, randomKanji()), startDelay + t * STEP_MS);
        }
        window.setTimeout(() => scheduleWrite(el, target), startDelay + TICKS * STEP_MS);
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", animateTextGroups);
  } else {
    animateTextGroups();
  }

  // 動画は画面に入ったときだけ再生する。動きを減らす設定の環境では再生しない
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => {
    if (reduce) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    });
    io.observe(v);
  });
</script>
