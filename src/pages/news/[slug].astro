---
import Layout from "@layouts/Layout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import { newsItems } from "../../data/news";
import { SITE, newsArticleSchema, breadcrumbSchema } from "../../lib/seo";

export function getStaticPaths() {
  return newsItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

// 記事の正規URL（サイトマップと揃えて trailing slash 付き）
const articleUrl = `${SITE.url}/news/${item.slug}/`;

// 記事（NewsArticle）とパンくずの構造化データ
const jsonLd = [
  newsArticleSchema(item, articleUrl),
  breadcrumbSchema([
    { name: "ホーム", url: `${SITE.url}/` },
    { name: "お知らせ", url: `${SITE.url}/news/` },
    { name: item.title, url: articleUrl },
  ]),
];
---

<Layout
  title={`${item.title} | 株式会社クリエイターのうえきばち`}
  description={item.excerpt}
  type="article"
  jsonLd={jsonLd}
  preloadMincho={false}
>
  <Navigation current="news" />

  <main>
    <article>
      <!-- 記事ヘッダー。どの一覧の記事か・いつの話かを先に示す -->
      <header class="band rule-top">
        <div class="shell">
          <div class="article-measure">
            <p class="small">
              <a href="/news/" class="link">お知らせ</a>
            </p>
            <p class="article-meta mt-4">
              <time class="num">{item.date}</time>
              <span class="article-cat">{item.category}</span>
            </p>
            <h1 class="article-title mt-4">{item.title}</h1>
          </div>
        </div>
      </header>

      <!-- 記事本文。受託の相談への導線は Footer の上段に任せ、ここには重ねない -->
      <section class="band band--alt">
        <div class="shell">
          <div class="article-measure">
            <div class="article-body">
              <Fragment set:html={item.content} />
            </div>

            <p class="mt-16 border-t border-[var(--rule)] pt-8">
              <a href="/news/" class="link font-bold">お知らせ一覧に戻る</a>
            </p>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  /* 1行を全角40字前後に収める */
  .article-measure {
    max-width: 40em;
  }

  .article-meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .article-cat {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--ink-2);
    padding: 1px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
  }

  .article-title {
    font-size: clamp(24px, 3.4vw, 36px);
    font-weight: 900;
    line-height: 1.45;
    color: var(--ink);
  }

  /* 記事本文（news.ts の HTML）の組版 */
  .article-body {
    font-size: var(--t-body);
    line-height: 1.9;
    color: var(--ink-2);
  }

  .article-body :global(p) {
    margin: 1.25em 0;
  }
  .article-body > :global(:first-child) {
    margin-top: 0;
  }

  .article-body :global(h2) {
    margin: 2.6em 0 0.9em;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
    font-size: var(--t-h3);
    font-weight: 900;
    line-height: 1.5;
    color: var(--ink);
  }

  /* 小見出し。左の細い線で本文と区別する */
  .article-body :global(h3) {
    margin: 2.4em 0 0.8em;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink);
  }

  .article-body :global(h4) {
    margin: 2em 0 0.6em;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--ink);
  }

  .article-body :global(ul) {
    margin: 1em 0 1.25em;
    padding-left: 1.4em;
    list-style: disc;
  }
  .article-body :global(ol) {
    margin: 1em 0 1.25em;
    padding-left: 1.6em;
    list-style: decimal;
  }
  .article-body :global(li) {
    margin: 0.35em 0;
    padding-left: 0.2em;
  }
  .article-body :global(li::marker) {
    color: var(--muted);
  }

  .article-body :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  .article-body :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color 0.15s;
  }
  .article-body :global(a:hover) {
    color: var(--accent-ink-hover);
  }
  .article-body :global(a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .article-body :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--card);
    border: 1px solid var(--rule);
    font-size: 0.9em;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }

  .article-body :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.2em 0 0.2em 1.2em;
    border-left: 3px solid var(--rule-strong);
    color: var(--muted);
  }

  .article-body :global(hr) {
    margin: 2.5em 0;
    border: none;
    border-top: 1px solid var(--rule);
  }
</style>
