---
import Layout from "@layouts/Layout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import { newsItems } from "../../data/news";
import { SITE, breadcrumbSchema } from "../../lib/seo";

const categories = [...new Set(newsItems.map((item) => item.category))];

// パンくず（トップ → お知らせ）の構造化データ
const breadcrumb = breadcrumbSchema([
  { name: "ホーム", url: `${SITE.url}/` },
  { name: "お知らせ", url: `${SITE.url}/news/` },
]);
---

<Layout
  title="お知らせ | 株式会社クリエイターのうえきばち"
  description="株式会社クリエイターのうえきばちのお知らせ・リリース情報の一覧です。NoLogicや会社の最新情報、コミュニティ運営に関するニュースを掲載しています。"
  jsonLd={[breadcrumb]}
  preloadMincho={false}
>
  <Navigation current="news" />

  <main>
    <header class="band rule-top">
      <div class="shell">
        <h1 class="h1">お知らせ</h1>
        <p class="lead mt-4 measure">会社とサービスの新しい情報、プレスリリースを載せています。</p>
      </div>
    </header>

    <section class="band band--alt" aria-label="お知らせの一覧">
      <div class="shell">
        <div class="news-measure">
          <!-- カテゴリで絞り込む。種類が1つしかないときは出さない -->
          {categories.length > 1 && (
            <div class="flex flex-wrap gap-2" id="category-filter" role="group" aria-label="カテゴリで絞り込む">
              <button type="button" data-category="all" class="filter-btn" aria-pressed="true">すべて</button>
              {categories.map((cat) => (
                <button type="button" data-category={cat} class="filter-btn" aria-pressed="false">{cat}</button>
              ))}
            </div>
          )}

          <!-- 記事リスト。日付・カテゴリ・タイトルの順に読めるよう、日付とカテゴリを1行目にまとめる -->
          <ul class="news-list mt-8" id="news-list">
            {newsItems.map((item) => (
              <li class="news-item" data-category={item.category}>
                <a href={`/news/${item.slug}/`} class="news-row">
                  <span class="news-meta">
                    <time class="num">{item.date}</time>
                    <span class="news-cat">{item.category}</span>
                  </span>
                  <span class="news-title">{item.title}</span>
                </a>
              </li>
            ))}
          </ul>

          <p id="no-results" class="small hidden py-8">該当するお知らせはありません。</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".news-item");
  const noResults = document.getElementById("no-results");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const category = btn.dataset.category;

      // 押したボタンだけを選択中にする（見た目は aria-pressed で切り替える）
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));

      let visibleCount = 0;
      items.forEach((item) => {
        const show = category === "all" || item.dataset.category === category;
        item.style.display = show ? "" : "none";
        if (show) visibleCount++;
      });

      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
    });
  });
</script>

<style>
  .news-measure {
    max-width: 52em;
  }

  .filter-btn {
    min-height: 40px;
    padding: 6px 16px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-2);
    font-size: var(--t-sm);
    font-weight: 700;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .filter-btn:hover {
    border-color: var(--ink);
  }
  .filter-btn[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .filter-btn:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .news-list {
    border-top: 1px solid var(--rule-strong);
  }
  .news-item {
    border-bottom: 1px solid var(--rule);
  }
  .news-row {
    display: grid;
    gap: 6px;
    padding: 20px 0;
  }
  @media (min-width: 768px) {
    .news-row {
      grid-template-columns: 13.5em 1fr;
      gap: 24px;
      align-items: baseline;
      padding: 22px 0;
    }
  }
  .news-meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .news-cat {
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--ink-2);
    padding: 1px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    white-space: nowrap;
  }
  .news-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.7;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .news-row:hover .news-title {
    color: var(--accent-ink);
    text-decoration-color: currentColor;
  }
  .news-row:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
