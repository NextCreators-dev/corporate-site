---
// 受託のサービスページ（/services/）。2026-10 改修（経営ポータルの決定 0087）、2026-11 に /techplantstudio/ から移した（決定 0097）
// 読み手は、代表からの連絡やトップページから来た企業の担当者。
//   B: Unity でゲームを作りたい企業 → #unity
//   C: 広告代理店・Web制作会社・イベント制作会社 → #minigame と #partner
//   D: 保育・療育の事業者 → #ai-training
//   F: イベントを外に頼みたい企業・団体 → #event
//   A: 版権・IP をお持ちの企業 → /services/ip-minigame/ へ送る
// 自分の用件・料金の目安・期間・体制・進め方を確かめ、フォームか日程調整で相談してもらう。
import Layout from "@layouts/Layout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import PortfolioCard from "@components/PortfolioCard.astro";
import ContactForm from "@components/ContactForm";
import { portfolioItems } from "../data/portfolio";
import { testimonials } from "../data/testimonials";
import { members } from "../data/members";
import { SITE, faqSchema, breadcrumbSchema } from "../lib/seo";
import {
  CONTACT_EMAIL,
  SCHEDULE_URL_BUSINESS,
  IS_EXTERNAL_SCHEDULE_URL,
} from "../lib/scheduling";

const pageTitle =
  "ゲーム制作の受託（Unity・ブラウザのミニゲーム）とAI研修 | 株式会社クリエイターのうえきばち";
const pageDescription =
  "株式会社クリエイターのうえきばちの受託制作。Unity でのゲーム開発は50万円から、自社のゲーム制作基盤 NoLogic を使うブラウザのミニゲームは20万円から（税別）。保育・療育の現場向けの AI 研修と導入支援も行っています。";

const IP_PAGE = "/services/ip-minigame/";
const BUSINESS_GAME_PAGE = "/business-game/";

const scheduleAttrs = IS_EXTERNAL_SCHEDULE_URL
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

// ── 1. ファーストビューの料金の目安 ───────────────────
// 最初の画面で「自分の用件はいくらくらいか」を確かめ、その節へ飛べるようにする
const heroPrices = [
