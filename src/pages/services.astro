---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd} preloadMincho={false}>
  <Navigation current="studio" contactHref="#contact" />

  <main>
    <!-- 1. ファーストビュー: 何を受けている会社か、いくらからか、どこから相談するか -->
    <section class="band" data-section="hero">
      <div class="shell grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="kicker">受託制作</p>
          <h1 class="h1 mt-3"><span class="inline-block">ゲーム開発と</span><span class="inline-block">AI導入支援の伴走が</span><span class="inline-block">得意領域です</span></h1>
          <p class="lead mt-6 measure">
            株式会社クリエイターのうえきばちの受託制作です。ミニゲームは、自社のゲーム制作基盤 NoLogic を使って作ります。保育・療育の現場向けの AI 研修と導入支援、イベントの企画・運営も行っています。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#contact" class="btn" data-cta-location="hero">相談する</a>
            <a href={SCHEDULE_URL_BUSINESS} {...scheduleAttrs} class="btn-line" data-schedule-location="hero">
              打ち合わせの日程を選ぶ
            </a>
          </div>
          <p class="small mt-4">お返事は2営業日以内です。</p>
          <p class="small mt-6 measure">
            版権・IP をお持ちの企業さまで、作品のミニゲームをお考えの方は、<a
              href={IP_PAGE}
              class="link"
              data-cta-location="hero_ip">IP のミニゲーム制作のご案内</a
            >をご覧ください。
          </p>
        </div>

        <div class="lg:col-span-5">
          <p class="small font-bold text-[var(--ink)]">料金の目安（税別）</p>
          <ul class="rule-ink mt-3">
            {
              heroPrices.map((p) => (
                <li class="border-b border-[var(--rule)]">
                  <a href={p.href} class="hero-price flex items-baseline justify-between gap-4 py-4">
                    <span class="body font-bold text-[var(--ink)]">{p.label}</span>
                    <span class="num shrink-0 text-right font-bold text-[var(--accent-ink)]">{p.price}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="small mt-3">正式な金額はお話を伺ってからお出しします。<a href="#pricing" class="link">料金の一覧</a></p>
        </div>
      </div>
    </section>

    <!-- 2. 受けている仕事: 用件ごとに、向く相談・やること・期間と料金・実績を同じ順で -->
    <section id="services" class="band band--alt" data-section="services">
      <div class="shell">
        <p class="kicker">受けている仕事</p>
        <h2 class="h2 mt-2">ご用件ごとの内容と目安</h2>
        <div class="mt-12 flex flex-col gap-16">
          {
            services.map((s) => (
              <article id={s.id} class="rule-ink grid gap-8 pt-8 lg:grid-cols-12" data-section={`service_${s.id}`}>
                <div class="lg:col-span-4">
                  <p class="kicker">{s.kicker}</p>
                  <h3 class="h2 mt-2">{s.title}</h3>
                  <p class="body mt-4">{s.summary}</p>
                  {s.id === "minigame" && (
                    <figure class="mt-8">
                      <video
                        class="block w-full rounded-lg border border-[var(--rule)] bg-[var(--card)]"
                        src="/nologic-play.mp4"
                        poster="/nologic-play-poster.jpg"
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        width="1280"
                        height="720"
                        data-autoplay
                        aria-label="NoLogic の制作画面で、キャラクターの画像を入れて落ちものパズルを作っている様子"
                      />
                      <figcaption class="small mt-3">
                        NoLogic の制作画面。キャラクターの画像を入れて、落ちものパズルを作っているところ。
                      </figcaption>
                    </figure>
                  )}
                </div>
                <div class="lg:col-span-8">
                  <dl class="service-rows">
                  {s.rows.map((r) => (
                    <div class="grid gap-1 border-b border-[var(--rule)] py-5 md:grid-cols-[10em_1fr] md:gap-6">
                      <dt class="small font-bold">{r.label}</dt>
                      <dd class="body" set:html={r.html} />
                    </div>
                  ))}
                  </dl>
                  {s.id === "minigame" && (
                    <p class="body mt-6">
                      版権・IP をお持ちの企業さま向けに、監修の進め方まで書いたご案内があります。
                      <a href={IP_PAGE} class="link" data-cta-location="minigame_ip">IP のミニゲーム制作のご案内</a>
                    </p>
                  )}
                </div>
              </article>
            ))
          }

          <!-- C の読み手: 制作会社・代理店が「ゲーム部分だけを任せられるか」を判断する -->
          <div id="partner" class="rule-top grid gap-6 pt-8 lg:grid-cols-12" data-section="partner">
            <div class="lg:col-span-4">
              <h3 class="h3">制作会社・広告代理店・イベント制作会社の方へ</h3>
            </div>
            <div class="lg:col-span-8">
              <p class="body measure">
                クライアントの案件のうち、ゲームの部分だけをお受けすることもできます。Unity の開発でも、ブラウザのミニゲームでもかまいません。進め方と体制は案件ごとにご相談します。フォームでは、ご相談の種類に「制作パートナー・協業のご相談」をお選びください。
              </p>
              <p class="mt-4">
                <a href="#contact" class="link" data-cta-location="partner">協業について相談する</a>
              </p>
            </div>
          </div>

          <!-- E の読み手は既存の LP へ。受託の入口より一歩下げる（決定 0084） -->
          <p class="small">
            社内研修や理念浸透に使うゲームは、<a href={BUSINESS_GAME_PAGE} class="link" data-cta-location="business_game">社内研修のゲームのページ</a>で料金と進め方をご案内しています。
          </p>
        </div>
      </div>
    </section>

    <!-- 3. 料金の目安: 用件ごとの下限を1つの表で比べる -->
    <section id="pricing" class="band" data-section="pricing">
      <div class="shell">
        <p class="kicker">料金の目安</p>
        <h2 class="h2 mt-2">料金と期間の目安</h2>
        <p class="body mt-4 measure">
          表の金額はいずれも税別の目安です。正式な金額は、お話を伺ってからお見積りでお出しします。
        </p>

        <table class="price-table mt-10 w-full">
          <thead>
            <tr>
              <th scope="col">ご依頼の内容</th>
              <th scope="col">料金の目安（税別）</th>
              <th scope="col">期間の目安</th>
              <th scope="col">補足</th>
            </tr>
          </thead>
          <tbody>
            {
              pricingRows.map((row) => (
                <>
                  {row.group && (
                    <tr class="price-group">
                      <th scope="colgroup" colspan="4">{row.group}</th>
                    </tr>
                  )}
                  <tr>
                    <th scope="row" data-label="ご依頼の内容">{row.name}</th>
                    <td data-label="料金の目安" class="num price">{row.price}</td>
                    <td data-label="期間の目安" class="dur">{row.duration}</td>
                    <td data-label="補足" class="note" set:html={row.note} />
                  </tr>
                </>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. 進め方: 次に何をすればよいかと、全体の期間 -->
    <section id="flow" class="band band--alt" data-section="flow">
      <div class="shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">進め方</p>
          <h2 class="h2 mt-2">ご相談から公開まで</h2>
          <p class="body mt-4">
            ミニゲームは早ければ2週間、Unity の開発は規模によって1〜4か月が目安です。
          </p>
        </div>
        <ol class="rule-ink lg:col-span-8">
          {
            flowSteps.map((step, i) => (
              <li class="grid gap-2 border-b border-[var(--rule)] py-6 md:grid-cols-[3em_1fr] md:gap-6">
                <span class="num text-[20px] font-black text-[var(--accent-ink)]">{i + 1}</span>
                <div>
                  <h3 class="h3">{step.title}</h3>
                  <p class="body mt-2">{step.body}</p>
                  {step.duration && <p class="small mt-2">目安: {step.duration}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 5. 体制: 誰が担当するかを顔写真つきで。人数は書かない -->
    <section id="team" class="band" data-section="team">
      <div class="shell">
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="kicker">体制</p>
            <h2 class="h2 mt-2">担当するメンバー</h2>
          </div>
          <div class="lg:col-span-8">
            <p class="body measure">
              企画、開発、QA、イラスト、3D、音楽、映像の担当が社内にいます。ご相談の窓口は代表の山縣です。
            </p>
            <p class="small mt-3">代表の山縣は、2021年度の未踏IT人材発掘・育成事業に採択されています。</p>
          </div>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-12">
          <!-- 選んだメンバーの紹介 -->
          <div id="member-detail" class="surface p-6 md:p-8 lg:col-span-7 lg:order-2" aria-live="polite">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
              <img
                id="detail-avatar"
                src={members[0].avatar}
                alt={`${members[0].name}の顔写真`}
                width="128"
                height="128"
                class="h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-[var(--rule-strong)]"
              />
              <div>
                <p class="h3">
                  <span id="detail-name">{members[0].name}</span>
                  <span id="detail-badge" class="small ml-2 font-bold">{members[0].isRepresentative ? "代表" : ""}</span>
                </p>
                <p id="detail-role" class="small mt-1">{members[0].role}</p>
                <p class="body mt-3 text-[var(--ink)]">
                  このページの依頼での担当: <span id="detail-assign">{assignment[members[0].name] ?? ""}</span>
                </p>
                <p id="detail-desc" class="body mt-3" set:html={members[0].desc} />
              </div>
            </div>
          </div>

          <!-- メンバーの一覧（押すと紹介が切り替わる） -->
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:col-span-5 lg:order-1 lg:grid-cols-2">
            {
              members.map((m, i) => (
                <li>
                  <button
                    type="button"
                    class="member-btn flex w-full items-center gap-3 rounded-lg border p-3 text-left"
                    aria-pressed={i === 0 ? "true" : "false"}
                    data-name={m.name}
                    data-role={m.role}
                    data-desc={m.desc}
                    data-assign={assignment[m.name] ?? ""}
                    data-representative={m.isRepresentative ? "true" : "false"}
                    data-avatar={m.avatar}
                  >
                    <img
                      src={m.avatar}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      class="h-12 w-12 shrink-0 rounded-full object-cover"
                    />
                    <span class="flex flex-col">
                      <span class="text-[15px] font-bold leading-snug text-[var(--ink)]">{m.name}</span>
                      <span class="text-[13px] leading-snug text-[var(--muted)]">{assignment[m.name] ?? ""}</span>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. 実績: 自分の依頼に近いものがあるか -->
    {
      portfolioItems.length > 0 && (
        <section id="works" class="band band--alt" data-section="portfolio">
          <div class="shell">
            <p class="kicker">実績</p>
            <h2 class="h2 mt-2">これまでの仕事</h2>
            <div class="rule-ink mt-8">
              {portfolioItems.map((item) => (
                <PortfolioCard item={item} />
              ))}
            </div>

            {testimonials.length > 0 && (
              <div class="mt-12">
                <h3 class="h3">お客さまの声</h3>
                <ul class="mt-4">
                  {testimonials.map((t) => (
                    <li class="border-b border-[var(--rule)] py-6">
                      <p class="body">{t.quote}</p>
                      <p class="small mt-2">
                        {t.name}・{t.role}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- 7. よくあるご質問: 依頼の前に迷う点 -->
    <section id="faq" class="band" data-section="faq">
      <div class="shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker">よくあるご質問</p>
          <h2 class="h2 mt-2">ご依頼の前に</h2>
        </div>
        <div class="rule-ink lg:col-span-8">
          {
            faqs.map((faq) => (
              <details class="faq border-b border-[var(--rule)]">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5">
                  <span class="body font-bold text-[var(--ink)]">{faq.question}</span>
                  <span class="faq-mark small shrink-0 font-bold" aria-hidden="true" />
                </summary>
                <p class="body pb-6 measure">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 8. 相談: フォームと、その代わりになる日程調整・メール -->
    <section id="contact" class="band band--alt" data-section="cta_bottom">
      <div class="shell grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <ContactForm
            client:load
            heading="ご相談"
            description={"作りたいものが決まっていなくてもかまいません。目的、公開したい時期、ご予算の目安を書いていただくと、進め方と費用の見通しをお返しできます。\nお返事は2営業日以内です。"}
          />
        </div>
        <aside class="lg:col-span-5">
          <div class="rule-ink pt-6">
            <h2 class="h3">打ち合わせの日程を先に決める</h2>
            <p class="body mt-3">
              オンラインの打ち合わせの空き時間から選べます。内容は打ち合わせで伺います。
            </p>
            <p class="mt-5">
              <a href={SCHEDULE_URL_BUSINESS} {...scheduleAttrs} class="btn-line" data-schedule-location="contact_aside">
                打ち合わせの日程を選ぶ
              </a>
            </p>
          </div>
          <div class="rule-top mt-10 pt-6">
            <h2 class="h3">メールで送る</h2>
            <p class="body mt-3">
              資料を添えて送りたい場合は、メールでも受け付けています。
            </p>
            <p class="mt-3">
              <a href={`mailto:${CONTACT_EMAIL}`} class="link" data-cta-location="contact_mail">{CONTACT_EMAIL}</a>
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer hideCta contactHref="#contact" />
</Layout>

<style>
  .hero-price {
    transition: background-color 0.15s;
  }

  .hero-price:hover {
    background: var(--paper-2);
  }

  .hero-price:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* 料金の表。PC では4列の表、スマホでは1件ずつの縦組みにする */
  .price-table {
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
  }

  .price-table thead th {
    padding: 14px 16px 14px 0;
    text-align: left;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--muted);
    border-bottom: 1px solid var(--rule-strong);
  }

  .price-table tbody th,
  .price-table tbody td {
    padding: 18px 16px 18px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-body);
    line-height: 1.8;
    color: var(--ink-2);
  }

  .price-table tbody th[scope="row"] {
    font-weight: 700;
    color: var(--ink);
    width: 30%;
  }

  .price-table .price {
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .price-table .dur {
    white-space: nowrap;
  }

  .price-table .note {
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .price-table .price-group th {
    padding-top: 32px;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--muted);
    border-bottom: 1px solid var(--rule-strong);
  }

  @media (max-width: 767px) {
    .price-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .price-table,
    .price-table tbody,
    .price-table tr,
    .price-table th,
    .price-table td {
      display: block;
      width: 100%;
    }

    .price-table tbody tr {
      padding: 16px 0;
      border-bottom: 1px solid var(--rule);
    }

    .price-table tbody th,
    .price-table tbody td {
      padding: 2px 0;
      border-bottom: 0;
    }

    .price-table tbody th[scope="row"] {
      width: 100%;
    }

    .price-table td:empty {
      display: none;
    }

    .price-table .price,
    .price-table .dur {
      white-space: normal;
    }

    .price-table tbody td[data-label]::before {
      content: attr(data-label) "　";
      font-size: var(--t-sm);
      color: var(--muted);
      font-weight: 400;
    }

    .price-table .price-group {
      padding-bottom: 0;
      border-bottom: 1px solid var(--rule-strong);
    }
  }

  .member-btn {
    border-color: var(--rule);
    background: var(--card);
    transition: background-color 0.15s, border-color 0.15s;
  }

  .member-btn:hover {
    background: var(--paper-2);
  }

  .member-btn[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .member-btn:focus-visible,
  .faq summary:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-mark::after {
    content: "開く";
    color: var(--accent-ink);
  }

  .faq[open] .faq-mark::after {
    content: "閉じる";
  }
</style>

<script>
  // cta_click と schedule_click は Layout.astro の共通スクリプトが送る。ここでは送らない
  function trackEvent(eventName: string, params: Record<string, string> = {}) {
    if (typeof window !== "undefined" && typeof (window as any).gtag === "function") {
      (window as any).gtag("event", eventName, params);
    }
  }

  // 節が画面に入ったら section_impression を送る
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const sectionName = (entry.target as HTMLElement).dataset.section;
        if (sectionName) trackEvent("section_impression", { section_name: sectionName });
        sectionObserver.unobserve(entry.target);
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll("[data-section]").forEach((el) => sectionObserver.observe(el));

  // よくある質問を開いたら faq_expand を送る
  document.querySelectorAll<HTMLDetailsElement>("details.faq").forEach((detail) => {
    detail.addEventListener("toggle", () => {
      if (!detail.open) return;
      const questionText = detail.querySelector("summary")?.textContent?.trim() || "";
      trackEvent("faq_expand", { faq_question: questionText });
    });
  });

  // 動画は画面に入ったときだけ再生する。動きを減らす設定の環境では再生しない
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion) {
    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.25 }
    );
    document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => videoObserver.observe(v));
  }

  // メンバーの紹介の切り替え
  const memberBtns = document.querySelectorAll<HTMLButtonElement>(".member-btn");
  const detailName = document.getElementById("detail-name");
  const detailRole = document.getElementById("detail-role");
  const detailDesc = document.getElementById("detail-desc");
  const detailAssign = document.getElementById("detail-assign");
  const detailBadge = document.getElementById("detail-badge");
  const detailAvatar = document.getElementById("detail-avatar") as HTMLImageElement | null;

  memberBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      memberBtns.forEach((b) => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      const d = btn.dataset;
      if (detailName) detailName.textContent = d.name || "";
      if (detailRole) detailRole.textContent = d.role || "";
      if (detailAssign) detailAssign.textContent = d.assign || "";
      // desc は members.ts の固定の HTML（外部入力ではない）
      if (detailDesc) detailDesc.innerHTML = d.desc || "";
      if (detailBadge) detailBadge.textContent = d.representative === "true" ? "代表" : "";
      if (detailAvatar && d.avatar) {
        detailAvatar.src = d.avatar;
        detailAvatar.alt = `${d.name || ""}の顔写真`;
      }
    });
  });
</script>
